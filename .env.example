# Copie para .env para rodar a API fora do Docker (uvicorn app.main:app --reload).
RESERVAI_REDIS_URL=redis://localhost:6379/0
RESERVAI_CASSANDRA_HOSTS=localhost
RESERVAI_CASSANDRA_KEYSPACE=reservai
RESERVAI_MONGO_URL=mongodb://localhost:27017
RESERVAI_MONGO_DB=reservai
RESERVAI_LIMITE_RESERVAS_ATIVAS=2
RESERVAI_DIAS_AGENDA_ABERTA=7
